<IfModule mod_rewrite.c>
    RewriteEngine On

    # امنع إعادة التوجيه المزدوج لو الطلب داخل public بالفعل
    RewriteCond %{REQUEST_URI} !^/public/

    # مرّر كل الطلبات إلى مجلد Laravel public
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<IfModule LiteSpeed>
    SetEnv noabort 1
</IfModule>
