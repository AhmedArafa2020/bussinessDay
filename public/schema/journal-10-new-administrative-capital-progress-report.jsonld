      "mainEntity": [
        {
          "@type": "Question",
          "name": "Is the New Administrative Capital finished?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Government functions have relocated and Phase 1 is substantially developed, but the city is in a long build-out. Full completion is planned across three phases."
          }
        },
        {
          "@type": "Question",
          "name": "How many people live in the New Administrative Capital?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Reported figures range from roughly 1,500 families in early 2024 to more than 30,000 residents in more recent ACUD statements, with 50,000–60,000 projected. Definitions vary between sources."
          }
        },
        {
          "@type": "Question",
          "name": "Has the Egyptian government actually moved to the new capital?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Ministries have relocated to the Government District and parliament sits in the new capital."
          }
        },
        {
          "@type": "Question",
          "name": "How far is the New Administrative Capital from Cairo?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Approximately 45 kilometres east of Cairo, connected by road and rail links."
          }
        },
        {
          "@type": "Question",
          "name": "How big will the New Administrative Capital be?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Planned at roughly 700–715 km² across three phases, with Phase 1 at about 168 km² and a design capacity of 6–6.5 million residents at full build-out."
          }
        }
      ]
