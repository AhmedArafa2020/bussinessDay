      "@type": "FAQPage",
      "@id": "https://businessbaydevelopments.com/journal/cost-of-buying-owning-property-egypt#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How much does it cost to buy property in Egypt beyond the price?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Commonly estimated at 4–6% of value in transaction costs, covering registration fees, legal fees and associated charges. Confirm the exact basis for your property."
          }
        },
        {
          "@type": "Question",
          "name": "Do foreigners pay higher property taxes in Egypt?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. There is no nationality surcharge; the same rates apply to Egyptians and foreign nationals."
          }
        },
        {
          "@type": "Question",
          "name": "What is the property transfer tax in Egypt?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A 2.5% real estate disposal tax on gross sale value. Under Egyptian law it is the seller's obligation."
          }
        },
        {
          "@type": "Question",
          "name": "Is there capital gains tax on property in Egypt?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Several sources state there is no separate capital gains tax for individuals selling residential property, the 2.5% disposal tax applying instead. Confirm the characterisation with advisers in both Egypt and your home country."
          }
        },
        {
          "@type": "Question",
          "name": "Is rental income from Egyptian property taxable?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, at progressive rates commonly reported between 10% and 27.5%. Your country of residence may tax it too, subject to any double taxation treaty."
          }
        }
      ]
    },
